# Copie para .env e preencha com seus valores (nunca faça commit do .env)
DATABASE_URL="postgresql://usuario:senha@host:5432/moria?sslmode=require"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
CORS_ORIGIN="http://localhost:4200"
PORT=3000
# Proxies reversos na frente da API (0 = local; 1 = hospedagem com proxy, ex.: Render)
TRUST_PROXY=0

# Primeiro usuário da coordenação (usado por: npm run db:seed)
SEED_COORDENACAO_NOME="Coordenação Moriá"
SEED_COORDENACAO_EMAIL="coordenacao@exemplo.org"
SEED_COORDENACAO_SENHA="troque-por-uma-senha-forte"

# Banco local via Docker (docker compose up -d). Com ele, use:
# DATABASE_URL="postgresql://moria:<POSTGRES_PASSWORD>@localhost:55432/moria"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"

# Educadora de demonstração (usado por: npm run db:seed:demo, dados fictícios)
SEED_EDUCADOR_EMAIL="educadora@exemplo.org"
SEED_EDUCADOR_SENHA="troque-por-uma-senha-forte"
